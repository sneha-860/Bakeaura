# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/bakeaura_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=hello

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME_HERE
CLOUDINARY_API_KEY=YOUR_API_KEY_HERE
CLOUDINARY_API_SECRET=YOUR_API_SECRET_HERE

# Fast2sms Configuration
FAST2SMS_API_KEY=YOUR_API_KEY_HERE

# JWT Configuration
JWT_SECRET=bakeaura_dev_secret_change_me

# Gemini AI Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Mail Configuration
# Development: use Mailtrap (sandbox.smtp.mailtrap.io port 2525) so emails don't go to real inboxes
# Production: use Gmail SMTP with an App Password (not your account password)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=YOUR_MAILTRAP_OR_GMAIL_USERNAME
MAIL_PASSWORD=YOUR_MAILTRAP_OR_GMAIL_APP_PASSWORD

# Frontend URL — used for email verification links
# Development: http://localhost:5173
# Production: https://your-deployed-frontend-url.com
APP_FRONTEND_URL=http://localhost:5173

# CORS Configuration
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# Delivery Configuration
DELIVERY_MAX_RADIUS_KM=10
DELIVERY_AVERAGE_SPEED_KMPH=30
DELIVERY_ROAD_DISTANCE_FACTOR=1.3
