# --- OS / Editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml

# --- Environment / Secrets ---
.env
.env.*
!.env.example

# --- Logs ---
*.log
logs/

# --- Node / Frontend ---
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/.nuxt/
frontend/.cache/
frontend/coverage/
