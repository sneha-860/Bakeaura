node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Java / Backend ---
backend/target/
backend/build/
backend/.mvn/wrapper/maven-wrapper.jar
# Common Java build output anywhere in repo:
target/
!**/src/main/**/target/
!**/src/test/**/target/

# --- Generic binaries/temp ---
*.class
*.jar
*.war
*.ear
tmp/
temp/
